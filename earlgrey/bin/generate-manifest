#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
	echo "Usage: $(basename "$0") <genomes-s3-prefix> [manifest-output-path]" >&2
	echo "  Lists .fna/.fa/.fasta (optionally .gz) files under the given s3://" >&2
	echo "  prefix and writes a tab-separated '<species>\\t<genome-s3-uri>'" >&2
	echo "  manifest, one line per genome, sorted by species. Species is" >&2
	echo "  derived from the filename (extension stripped, non-alphanumerics" >&2
	echo "  collapsed to '_', lowercased) — review the output and edit any" >&2
	echo "  names before submitting." >&2
	echo "Example: $(basename "$0") s3://my-bucket/genomes/ manifest.tsv" >&2
	exit 1
fi

prefix="$1"
[[ "$prefix" == s3://* ]] || {
	echo "genomes prefix must be an s3:// URI" >&2
	exit 1
}
out="${2:-manifest.tsv}"
bucket="$(sed -E 's#^s3://([^/]+)/?.*#\1#' <<<"$prefix")"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

aws s3 ls --recursive "$prefix" | awk '{print $4}' | while read -r key; do
	case "$key" in
	*.fna | *.fa | *.fasta | *.fna.gz | *.fa.gz | *.fasta.gz) ;;
	*) continue ;;
	esac
	base="$(basename "$key")"
	species="$(sed -E 's/\.(fna|fa|fasta)(\.gz)?$//' <<<"$base" | tr -c 'A-Za-z0-9' '_' | tr 'A-Z' 'a-z')"
	echo -e "${species}\ts3://${bucket}/${key}"
done | sort -u >"$tmp"

if [ ! -s "$tmp" ]; then
	echo "No genome files found under $prefix" >&2
	exit 1
fi

dup="$(cut -f1 "$tmp" | sort | uniq -d)"
if [ -n "$dup" ]; then
	echo "Warning: duplicate species names derived from filenames — edit $out to disambiguate before submitting:" >&2
	echo "$dup" >&2
fi

mv "$tmp" "$out"
echo "Wrote $(wc -l <"$out" | tr -d ' ') genomes to $out" >&2
