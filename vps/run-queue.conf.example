# Copy to run-queue.conf (in the directory you run run-queue.sh from, or
# point at this file with --config <path>) to avoid retyping the manifest
# slice on every invocation. MANIFEST can still be overridden with a
# positional arg when you run the script — a positional arg wins.

# Each box has its own fixed manifest slice (see vps/README.md).
MANIFEST=manifest-01.tsv

# Dfam/output/threads are NOT configured here — they live in run-earlgrey's
# own config file instead (see ../earlgrey/bin/run-earlgrey.conf.example),
# since this script just iterates the manifest and hands each genome off to
# run-earlgrey. Uncomment only if that config file isn't at run-earlgrey's
# default lookup location (./run-earlgrey.conf in the directory you run
# run-queue.sh from):
# EARLGREY_CONFIG=/path/to/run-earlgrey.conf
