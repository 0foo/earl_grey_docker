#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
	echo "Usage: $(basename "$0") <genomes-dir> [manifest-output-path]" >&2
	echo "  Lists .fna/.fa/.fasta (optionally .gz) files under the given" >&2
	echo "  local directory, and writes a tab-separated" >&2
	echo "  '<species>\\t<genome-path>' manifest, one line per genome," >&2
	echo "  sorted by species. Species is derived from the filename (extension" >&2
	echo "  and a trailing .rm segment stripped, non-alphanumerics collapsed" >&2
	echo "  to '_', lowercased) — review the output and edit any names before" >&2
	echo "  submitting." >&2
	echo "Example: $(basename "$0") /data/genomes/2_unmasked_datasets manifest.tsv" >&2
	exit 1
fi

prefix="$1"
out="${2:-manifest.tsv}"

tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

if [ ! -d "$prefix" ]; then
	echo "genomes path must be an existing local directory" >&2
	exit 1
fi
prefix="$(realpath "$prefix")"
find "$prefix" -type f | while read -r filepath; do
	case "$filepath" in
	*.fna | *.fa | *.fasta | *.fna.gz | *.fa.gz | *.fasta.gz) ;;
	*) continue ;;
	esac
	base="$(basename "$filepath")"
	# printf, not <<<"$base" — a here-string appends a trailing newline
	# that tr -c would otherwise convert into a spurious trailing
	# underscore. (\.rm)? strips a trailing ".rm" segment too (e.g.
	# "Species.nanopore.rm.fna.gz" -> "species_nanopore", not
	# "..._nanopore_rm") — it's a naming-convention artifact in this
	# dataset, not disambiguating information.
	species="$(printf '%s' "$base" | sed -E 's/(\.rm)?\.(fna|fa|fasta)(\.gz)?$//I' | tr -c 'A-Za-z0-9' '_' | tr 'A-Z' 'a-z')"
	echo -e "${species}\t${filepath}"
done | sort -u >"$tmp"

if [ ! -s "$tmp" ]; then
	echo "No genome files found under $prefix" >&2
	exit 1
fi

dup="$(cut -f1 "$tmp" | sort | uniq -d)"
if [ -n "$dup" ]; then
	echo "Warning: duplicate species names derived from filenames — edit $out to disambiguate before submitting:" >&2
	echo "$dup" >&2
fi

mv "$tmp" "$out"
echo "Wrote $(wc -l <"$out" | tr -d ' ') genomes to $out" >&2
