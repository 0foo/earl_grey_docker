#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
	echo "Usage: $(basename "$0") <job-id>" >&2
	echo "  Prints the full 'aws batch describe-jobs' status+attempts JSON" >&2
	echo "  (task ARN, log stream, start/stop times, statusReason for every" >&2
	echo "  attempt) for every child of an array job, one after another." >&2
	echo "  Falls back to a single describe-jobs call if job-id isn't an" >&2
	echo "  array job. For aggregate counts instead, see bin/batch-dashboard" >&2
	echo "  (which also has a --raw flag for the same JSON, alongside its" >&2
	echo "  status/runtime view)." >&2
	echo "Example: $(basename "$0") abcd1234-..." >&2
	exit 1
fi

job_id="$1"

# Species names for readable headers — best-effort, falls back to just the
# index if the manifest can't be found (e.g. this isn't a submit-batch job).
manifest_local=""
manifest_s3="$(aws batch describe-jobs --jobs "$job_id" \
	--query 'jobs[0].container.environment[?name==`MANIFEST_S3_URI`].value | [0]' --output text 2>/dev/null || true)"
if [ -n "$manifest_s3" ] && [ "$manifest_s3" != "None" ]; then
	manifest_local="$(mktemp)"
	trap 'rm -f "$manifest_local"' EXIT
	aws s3 cp "$manifest_s3" "$manifest_local" --only-show-errors
fi

species_for_index() {
	local idx="$1"
	if [ -n "$manifest_local" ]; then
		cut -f1 <<<"$(sed -n "$((idx + 1))p" "$manifest_local")"
	fi
}

describe_one() {
	local target="$1" label="$2"
	echo "=== $label ($target) ===" >&2
	aws batch describe-jobs --jobs "$target" \
		--query 'jobs[0].{status:status,attempts:attempts}' --output json
}

children="$(aws batch list-jobs --array-job-id "$job_id" --query 'jobSummaryList[].arrayProperties.index' --output text)"

if [ -z "$children" ]; then
	describe_one "$job_id" "$job_id"
else
	for idx in $(tr '\t' '\n' <<<"$children" | sort -n); do
		species="$(species_for_index "$idx")"
		label="${idx}${species:+-$species}"
		describe_one "${job_id}:${idx}" "$label"
	done
fi
