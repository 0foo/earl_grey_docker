#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
	echo "Usage: $(basename "$0") <dir>" >&2
	echo "  Runs check-fasta on every file in <dir>. A failure is logged and skipped, not fatal." >&2
	echo "Example: $(basename "$0") /data/bioinfo/data/genomes/1_masked_datasets/genomes_dhakad" >&2
	exit 1
fi

dir="$(realpath -m "$1")"
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

ok=0
failed=()
for f in "$dir"/*; do
	[ -f "$f" ] || continue
	name="$(basename "$f")"
	if "$script_dir/check-fasta" "$f" >/dev/null; then
		echo "OK: $name"
		ok=$((ok + 1))
	else
		echo "INVALID: $name" >&2
		failed+=("$name")
	fi
done

echo
echo "Done: $ok valid, ${#failed[@]} invalid."
if [ "${#failed[@]}" -gt 0 ]; then
	printf 'Invalid files:\n'
	printf '  %s\n' "${failed[@]}"
	exit 1
fi
