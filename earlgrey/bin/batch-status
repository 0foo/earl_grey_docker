#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
	echo "Usage: $(basename "$0") <job-id>" >&2
	echo "  Shows status of an AWS Batch job. For an array job, also shows a" >&2
	echo "  count of child jobs by status (RUNNING/SUCCEEDED/FAILED/...)." >&2
	exit 1
fi

job_id="$1"

aws batch describe-jobs --jobs "$job_id" \
	--query 'jobs[0].{status:status,statusReason:statusReason,arraySize:arrayProperties.size}' \
	--output table

children="$(aws batch list-jobs --array-job-id "$job_id" --query 'jobSummaryList[].status' --output text 2>/dev/null || true)"
if [ -n "$children" ]; then
	echo "Child job status counts:"
	tr '\t' '\n' <<<"$children" | sort | uniq -c | sort -rn
fi
