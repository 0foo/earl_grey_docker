#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
	echo "Usage: $(basename "$0") <input.fna> [output.fna]" >&2
	echo "  Both are real host paths (absolute or relative to your cwd)." >&2
	echo "  Output defaults to <input>.unmasked.<ext> next to the input." >&2
	echo "Example: $(basename "$0") /data/bioinfo/data/genomes/raw_data/genome.fna" >&2
	exit 1
fi

input="$(realpath -m "$1")"
output="$(realpath -m "${2:-${input%.*}.unmasked.${input##*.}}")"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$script_dir/run-bio" seqkit seq -u "$input" -o "$output"

echo "Wrote: $output"
