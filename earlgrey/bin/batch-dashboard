#!/usr/bin/env bash
set -euo pipefail

target=""
raw=0
for arg in "$@"; do
	case "$arg" in
	--raw) raw=1 ;;
	*) target="$arg" ;;
	esac
done

if [ -z "$target" ]; then
	echo "Usage: $(basename "$0") <job-queue-or-job-id> [--raw]" >&2
	echo "  One-shot status view. Pass a job queue name to see every job/child" >&2
	echo "  on it, or a specific job ID to see just that one (with its child" >&2
	echo "  breakdown if it's an array job). Either way: status, runtime, and" >&2
	echo "  reason per job/child, drilling into array children rather than" >&2
	echo "  trusting the array job's own top-level status (which can lag well" >&2
	echo "  behind — observed staying PENDING while children were actively" >&2
	echo "  RUNNING). Also lists the compute environment's running EC2" >&2
	echo "  instances with an estimated cost so far. For logs, see" >&2
	echo "  bin/batch-logs." >&2
	echo "  --raw additionally dumps the full describe-jobs JSON (task ARN," >&2
	echo "  attempts, container details, everything) for every job/child." >&2
	echo "Example: $(basename "$0") earlgrey-queue" >&2
	echo "Example: $(basename "$0") earlgrey-queue --raw" >&2
	echo "Example: $(basename "$0") b02a68d4-3628-4732-94b0-353252bc2baa" >&2
	exit 1
fi

now_ms="$(date +%s%3N)"

# ms -> "XhYm". Used for RUNNING jobs (elapsed so far) and completed ones
# (their actual startedAt-to-stoppedAt duration).
format_duration() {
	local total_s=$(( $1 / 1000 ))
	local h=$(( total_s / 3600 ))
	local m=$(( (total_s % 3600) / 60 ))
	printf '%dh%dm' "$h" "$m"
}

runtime_for() {
	local started="$1" stopped="$2"
	if [ -z "$started" ] || [ "$started" = "None" ]; then
		echo "-"
		return
	fi
	local end_ms="$now_ms"
	if [ -n "$stopped" ] && [ "$stopped" != "None" ]; then
		end_ms="$stopped"
	fi
	format_duration $((end_ms - started))
}

# A bare job ID (UUID) means "show me just this one job"; anything else is
# treated as a job queue name and we enumerate everything on it.
if [[ "$target" =~ ^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$ ]]; then
	job_ids="$target"
	echo "=== Job: $target ==="
else
	job_ids="$(for status in SUBMITTED PENDING RUNNABLE STARTING RUNNING SUCCEEDED FAILED; do
		aws batch list-jobs --job-queue "$target" --job-status "$status" \
			--query 'jobSummaryList[].jobId' --output text
	done)"
	if [ -z "$job_ids" ]; then
		echo "No jobs found on queue $target."
		exit 0
	fi
	echo "=== Per submitted job on queue: $target ==="
fi

all_statuses=""
for job_id in $job_ids; do
	children="$(aws batch list-jobs --array-job-id "$job_id" --query 'jobSummaryList[].status' --output text 2>/dev/null || true)"
	if [ -n "$children" ]; then
		echo "$job_id (array) — for one genome's logs: bin/batch-logs $job_id <index>"
		printf '%-6s %-10s %-8s %s\n' "Index" "Status" "Runtime" "Reason"
		indices="$(aws batch list-jobs --array-job-id "$job_id" \
			--query 'sort_by(jobSummaryList, &arrayProperties.index)[].[arrayProperties.index,status,startedAt,stoppedAt,statusReason]' \
			--output text)"
		echo "$indices" | while IFS=$'\t' read -r idx cstatus started stopped reason; do
			if [ -z "$idx" ]; then
				continue
			fi
			printf '%-6s %-10s %-8s %s\n' "$idx" "$cstatus" "$(runtime_for "$started" "$stopped")" "$reason"
		done
		echo "Status counts:"
		tr '\t' '\n' <<<"$children" | sort | uniq -c | sort -rn
		all_statuses="$all_statuses"$'\n'"$children"
		if [ "$raw" -eq 1 ]; then
			echo "$indices" | while IFS=$'\t' read -r idx _ _ _ _; do
				if [ -z "$idx" ]; then
					continue
				fi
				echo "--- raw describe-jobs: ${job_id}:${idx} ---"
				aws batch describe-jobs --jobs "${job_id}:${idx}" --output json
			done
		fi
	else
		top="$(aws batch describe-jobs --jobs "$job_id" --query 'jobs[0].[status,startedAt,stoppedAt]' --output text)"
		top_status="$(cut -f1 <<<"$top")"
		started="$(cut -f2 <<<"$top")"
		stopped="$(cut -f3 <<<"$top")"
		echo "$job_id (single job — for logs: bin/batch-logs $job_id): $top_status (runtime: $(runtime_for "$started" "$stopped"))"
		all_statuses="$all_statuses"$'\n'"$top_status"
		if [ "$raw" -eq 1 ]; then
			echo "--- raw describe-jobs: $job_id ---"
			aws batch describe-jobs --jobs "$job_id" --output json
		fi
	fi
done

echo
echo "=== Totals across all genomes ==="
tr '\t' '\n' <<<"$all_statuses" | sed '/^$/d' | sort | uniq -c | sort -rn

echo
echo "=== Running EC2 instances & estimated cost ==="
echo "(On-Demand-equivalent estimate, not live-queried — actual Spot cost is typically 30-40% of this)"

# us-east-1 On-Demand $/hr for the memory-optimized types in batch.yaml's
# InstanceTypes default — a fixed approximation, not a live price lookup.
declare -A hourly_rate=(
	[r5.4xlarge]=1.008 [r5.8xlarge]=2.016
	[r5a.4xlarge]=0.904 [r5a.8xlarge]=1.808
	[r6i.4xlarge]=1.008 [r6i.8xlarge]=2.016
	[r6a.4xlarge]=0.907 [r6a.8xlarge]=1.814
)

instances="$(aws ec2 describe-instances \
	--filters "Name=tag:Name,Values=earlgrey-batch-worker" "Name=instance-state-name,Values=running" \
	--query "Reservations[].Instances[].[InstanceId,InstanceType,LaunchTime]" --output text)"

if [ -z "$instances" ]; then
	echo "No running instances found (tag Name=earlgrey-batch-worker)."
else
	printf '%-20s %-13s %-7s %s\n' "Instance" "Type" "Hours" "Est. Cost"
	total_cost="0"
	now_s="$(date -u +%s)"
	while IFS=$'\t' read -r iid itype launch; do
		if [ -z "$iid" ]; then
			continue
		fi
		launch_s="$(date -d "$launch" +%s)"
		hours="$(awk -v a="$launch_s" -v b="$now_s" 'BEGIN{printf "%.2f", (b-a)/3600}')"
		rate="${hourly_rate[$itype]:-}"
		if [ -z "$rate" ]; then
			printf '%-20s %-13s %-7s %s\n' "$iid" "$itype" "$hours" "(unknown type, no rate)"
			continue
		fi
		cost="$(awk -v h="$hours" -v r="$rate" 'BEGIN{printf "%.2f", h*r}')"
		total_cost="$(awk -v t="$total_cost" -v c="$cost" 'BEGIN{printf "%.2f", t+c}')"
		printf '%-20s %-13s %-7s $%s\n' "$iid" "$itype" "$hours" "$cost"
	done <<<"$instances"
	echo "Total estimated On-Demand-equivalent cost so far: \$${total_cost} (actual Spot cost is typically 30-40% of this)"
fi
