#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 2 ]; then
	echo "Usage: $(basename "$0") <input-dir> <output-dir>" >&2
	echo "  Runs unmask-genome on every file in <input-dir>, writing same-named files into <output-dir>." >&2
	echo "Example: $(basename "$0") /data/bioinfo/data/genomes/1_masked_datasets/genomes_dhakad /data/bioinfo/data/genomes/2_unmasked_datasets" >&2
	exit 1
fi

src="$(realpath -m "$1")"
dst="$(realpath -m "$2")"
mkdir -p "$dst"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

for f in "$src"/*; do
	[ -f "$f" ] || continue
	name="$(basename "$f")"
	echo "Unmasking $name..."
	"$script_dir/unmask-genome" "$f" "$dst/$name"
done
