#!/usr/bin/env bash
set -euo pipefail

if [ $# -lt 1 ]; then
	echo "Usage: $(basename "$0") <accession> [output.fna]" >&2
	echo "  Output is a real host path (absolute or relative to your cwd)." >&2
	echo "  Defaults to ./<accession>.fna in your current directory." >&2
	echo "Example: $(basename "$0") GCF_016746365.2 /data/bioinfo/data/genomes/raw_data/GCF_016746365.2.fna" >&2
	exit 1
fi

accession="$1"
output="$(realpath -m "${2:-./${accession}.fna}")"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Downloads inside the container's own /tmp (not bind-mounted, discarded with
# --rm), then moves the extracted .fna to $output — the one path that's
# mounted. $1/$2 are accession/output, passed as real argv so nothing needs
# escaping into the script text.
"$script_dir/run-bio" bash -c '
set -euo pipefail
accession="$1"
output="$2"
tmp="$(mktemp -d)"
cd "$tmp"
datasets download genome accession "$accession" --include genome --filename genome.zip
unzip -q -o genome.zip
fna="$(find "ncbi_dataset/data/$accession" -name "*.fna" | head -n1)"
mkdir -p "$(dirname "$output")"
mv "$fna" "$output"
cd /
rm -rf "$tmp"
' _ "$accession" "$output"

echo "Wrote: $output"
