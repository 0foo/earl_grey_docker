#!/usr/bin/env bash
set -euo pipefail

print_usage() {
	echo "Usage: $(basename "$0") <genome-file> <species> [options]" >&2
	echo "  All paths are on your local filesystem (host paths). dfam-dir and" >&2
	echo "  output-dir tend to stay the same across runs, so they (and" >&2
	echo "  threads) can come from --flags, a config file, or both — flags" >&2
	echo "  win over the config file for anything set in both:" >&2
	echo "    --config <path>   Config file (default: ./run-earlgrey.conf if" >&2
	echo "                      it exists — see run-earlgrey.conf.example)." >&2
	echo "    --dfam <dir>      Dfam famdb directory. Required (flag or config)." >&2
	echo "    --output <dir>    Output directory. Required (flag or config)." >&2
	echo "    --threads <n>     Threads to use. Default: 4." >&2
	echo "  Skips this species if its output already completed successfully" >&2
	echo "  (resume-safe across restarts — detected by an EarlGrey log" >&2
	echo "  existing with no INCOMPLETE_RUN.txt marker next to it. This" >&2
	echo "  script writes that marker itself before every run starts and" >&2
	echo "  only clears it after a confirmed zero exit, so even a hard kill" >&2
	echo "  (docker kill, OOM, double Ctrl+C) leaves the run flagged" >&2
	echo "  incomplete instead of being mistaken for a completed one." >&2
	echo "Example (config file supplies dfam/output/threads):" >&2
	echo "  $(basename "$0") genome.fna.gz dmel" >&2
	echo "Example (all flags): $(basename "$0") genome.fna.gz dmel \\" >&2
	echo "  --dfam /data/bioinfo/data/dfam_data --output /data/bioinfo/data/output --threads 8" >&2
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
	print_usage
	exit 1
fi

if [ $# -lt 2 ]; then
	print_usage
	exit 1
fi

genome_arg="$1"
species="$2"
shift 2

config=""
dfam=""
output=""
threads=""

while [ $# -gt 0 ]; do
	case "$1" in
	--config)
		config="$2"
		shift 2
		;;
	--dfam)
		dfam="$2"
		shift 2
		;;
	--output)
		output="$2"
		shift 2
		;;
	--threads)
		threads="$2"
		shift 2
		;;
	*)
		echo "Unknown option: $1" >&2
		print_usage
		exit 1
		;;
	esac
done

if [ -z "$config" ] && [ -f "./run-earlgrey.conf" ]; then
	config="./run-earlgrey.conf"
fi

if [ -n "$config" ]; then
	if [ ! -f "$config" ]; then
		echo "Config file not found: $config" >&2
		exit 1
	fi
	# Config sets DFAM/OUTPUT/THREADS (distinct names from this script's
	# own dfam/output/threads) so a --flag already set from the command
	# line is never clobbered by sourcing this file.
	# shellcheck disable=SC1090
	source "$config"
	if [ -z "$dfam" ]; then
		dfam="${DFAM:-}"
	fi
	if [ -z "$output" ]; then
		output="${OUTPUT:-}"
	fi
	if [ -z "$threads" ]; then
		threads="${THREADS:-}"
	fi
fi

threads="${threads:-4}"

if [ -z "$dfam" ] || [ -z "$output" ]; then
	echo "Missing --dfam/--output — supply each via a flag or a config file (see --help)." >&2
	exit 1
fi

genome="$(realpath -m "$genome_arg")"
dfam="$(realpath -m "$dfam")"
output="$(realpath -m "$output")"

# Each species gets its own subdirectory under the shared $output root —
# not just for organization, but because entrypoint.sh writes
# INCOMPLETE_RUN.txt directly into whatever -o path it's given, so -o must
# be species-specific for that marker (and the resume check below) to mean
# anything when $output is reused across many species over time.
dest="$output/$species"
mkdir -p "$dest"

log_marker="$dest/${species}_EarlGrey/${species}_EarlGrey.log"
incomplete_marker="$dest/INCOMPLETE_RUN.txt"
if [ -f "$log_marker" ] && [ ! -f "$incomplete_marker" ]; then
	echo "$species — already completed, skipping" >&2
	exit 0
fi

# earlGrey doesn't unzip local inputs itself (only s3:// inputs auto-unzip,
# via the entrypoint) — decompress a .gz genome once to a deterministic,
# persistent path inside $dest, not a randomly-named temp file. earlGrey
# resumes a stopped run by checking which output files already exist, and
# its later stages (e.g. TEstrainer) end up referencing this genome path
# internally — a random name deleted on exit broke resume entirely, since a
# rerun got a *different* random name pointing at nothing. Reused as-is if
# it already exists; never deleted here (it's just another artifact of
# $dest, cleaned up along with everything else if you wipe this species'
# output directory).
if [[ "$genome" == *.gz ]]; then
	decompressed="$dest/${species}.genome.fna"
	if [ ! -e "$decompressed" ]; then
		gunzip -c "$genome" >"$decompressed"
	fi
	genome="$decompressed"
fi

# The genome is mounted by its containing directory (not the file itself)
# at the identical host path, so -g can reference it unchanged; same for
# the output dir. Only the Dfam famdb mount has a fixed container target —
# that path is baked into the conda env earlGrey expects it at.
genome_dir="$(dirname "$genome")"

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$script_dir/.."

mounts=(-v "$dfam:/opt/conda/envs/earlgrey/share/famdb-3.0.0/Libraries/famdb" -v "$output:$output")
# Skip a redundant extra mount if the genome is already under $output (e.g.
# the decompressed path above, or an original input already living there) —
# the -v "$output:$output" mount already covers it.
if [ "$genome_dir" != "$output" ] && [[ "$genome_dir" != "$output"/* ]]; then
	mounts+=(-v "$genome_dir:$genome_dir")
fi

# Sample host resource usage for just this run's duration, right alongside
# its output — host-level (not per-container), which is accurate as long as
# this is the only job running on the box (the normal case: run-queue.sh
# runs one genome at a time).
"$script_dir/monitor-resources.sh" "$dest/resource-usage.csv" 10 &
monitor_pid=$!
trap 'kill "$monitor_pid" 2>/dev/null || true' EXIT

# Written up front, before the container even starts, and only removed
# below on a confirmed zero exit. entrypoint.sh also writes this marker
# itself when it catches a non-zero exit from earlGrey, but that only
# covers a graceful failure — a hard kill (docker kill, OOM, double
# Ctrl+C) can take the whole container down before entrypoint.sh gets to
# run that logic. Pre-writing it here means the resume check above is
# never fooled by that case: it's already marked incomplete before the
# run does anything, and success is the only thing that clears it.
{
	echo "RUN IN PROGRESS"
	echo "Started at: $(date -u +%FT%TZ)"
	echo "If this file is still here after the run ends, it was interrupted before finishing."
} >"$incomplete_marker"

set +e
docker compose --progress quiet run --rm "${mounts[@]}" \
	earlgrey -g "$genome" -s "$species" -o "$dest" -t "$threads"
status=$?
set -e

if [ "$status" -eq 0 ]; then
	rm -f "$incomplete_marker"
else
	exit "$status"
fi
